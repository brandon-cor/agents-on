#!/bin/bash
set -euo pipefail
app="$HOME/Applications/Agents On.app/Contents/MacOS/AgentsOn"
if [[ $# != 1 ]]; then
  echo 'Usage: agents on | agents off | agents status | agents show | agents doctor' >&2
  exit 2
fi
case "$1" in
  on|off)
    value=0
    [[ "$1" == on ]] && value=1
    if ! /usr/bin/sudo -n /usr/bin/pmset -a disablesleep "$value"; then
      echo 'Run the Agents On installer to enable password-free toggling.' >&2
      exit 1
    fi
    /bin/bash "$HOME/Library/Application Support/Agents On/start.sh" >/dev/null
    "$app" --refresh
    actual=$(/usr/bin/pmset -g | /usr/bin/awk '$1 == "SleepDisabled" {print $2}')
    [[ "$actual" == "$value" ]] || { echo 'Could not verify the sleep setting.' >&2; exit 1; }
    echo "agents $1"
    ;;
  status) "$app" --status ;;
  show)
    /bin/bash "$HOME/Library/Application Support/Agents On/start.sh" >/dev/null
    "$app" --show ;;
  doctor) /bin/bash "$HOME/Library/Application Support/Agents On/doctor.sh" ;;
  *) echo 'Usage: agents on | agents off | agents status | agents show | agents doctor' >&2; exit 2 ;;
esac
